# ---- OpenAI ----
OPENAI_API_KEY=sk-your-openai-key
CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# ---- Frontend origin (for CORS) ----
FRONTEND_ORIGIN=https://your-frontend.vercel.app

# ---- Excel ticket store ----
TICKETS_PATH=data/tickets.xlsx

# ---- Google OAuth (Gmail + Calendar) - see docs/GOOGLE_SETUP.md ----
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
GOOGLE_REFRESH_TOKEN=xxxx
COMPANY_SENDER_EMAIL=support@yourdomain.com
OWNER_NOTIFICATION_EMAIL=you@yourdomain.com
GOOGLE_CALENDAR_ID=primary

# ---- Automation ----
AUTOMATION_SECRET=change-me-to-a-long-random-string
AUTO_REPLY_CONFIDENCE_THRESHOLD=0.7
ENABLE_IN_PROCESS_SCHEDULER=true
TICKET_PROCESS_INTERVAL_MINUTES=10
